<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Financial data, tokens, device identity and encrypted local state are
         never exported through Android backup or device migration. -->
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>

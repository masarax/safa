Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle SAFA API security headers
    RewriteCond %{HTTP:X-SAFA-API-KEY} .
    RewriteRule .* - [E=HTTP_X_SAFA_API_KEY:%{HTTP:X-SAFA-API-KEY}]
    RewriteCond %{HTTP:X-SAFA-SIGNATURE} .
    RewriteRule .* - [E=HTTP_X_SAFA_SIGNATURE:%{HTTP:X-SAFA-SIGNATURE}]
    RewriteCond %{HTTP:X-SAFA-TIMESTAMP} .
    RewriteRule .* - [E=HTTP_X_SAFA_TIMESTAMP:%{HTTP:X-SAFA-TIMESTAMP}]
    RewriteCond %{HTTP:X-SAFA-NONCE} .
    RewriteRule .* - [E=HTTP_X_SAFA_NONCE:%{HTTP:X-SAFA-NONCE}]
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # The authenticated browser application uses /app and /app/api/* as
    # Laravel routes. They must be rewritten before the internal-source deny.
    RewriteRule ^app/?$ index.php [L]
    RewriteRule ^app/api(?:/.*)?$ index.php [L]

    # Generated raster branding is intentionally public. This exact filename
    # contract is the only allowed URL surface inside storage/.
    RewriteRule ^storage/logos/logo_[A-Za-z0-9_-]+\.(?:png|jpe?g|gif|webp)$ - [L,NC]

    # Never serve internal files/directories. Requests such as /app/Http/...
    # remain forbidden while the legitimate browser application routes above
    # are handled by Laravel.
    RewriteRule ^(?:\.env|\.git|app|bootstrap|config|database|deploy|resources|routes|storage|tests|vendor|composer\.(?:json|lock)|package\.(?:json|lock)|artisan|phpunit\.xml)(?:/|$) - [F,L]

    # Route public requests through Laravel.
    RewriteRule ^ index.php [L]
</IfModule>

<FilesMatch "^\.|\.env|composer\.(json|lock)|package\.(json|lock)|artisan|phpunit\.xml|README\.md">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

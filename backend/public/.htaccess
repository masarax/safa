# SAFA is an API-only service. Browser-facing files must never be served.
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle SAFA API security headers
    RewriteCond %{HTTP:X-SAFA-API-KEY} .
    RewriteRule .* - [E=HTTP_X_SAFA_API_KEY:%{HTTP:X-SAFA-API-KEY}]
    RewriteCond %{HTTP:X-SAFA-SIGNATURE} .
    RewriteRule .* - [E=HTTP_X_SAFA_SIGNATURE:%{HTTP:X-SAFA-SIGNATURE}]
    RewriteCond %{HTTP:X-SAFA-TIMESTAMP} .
    RewriteRule .* - [E=HTTP_X_SAFA_TIMESTAMP:%{HTTP:X-SAFA-TIMESTAMP}]
    RewriteCond %{HTTP:X-SAFA-NONCE} .
    RewriteRule .* - [E=HTTP_X_SAFA_NONCE:%{HTTP:X-SAFA-NONCE}]
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Never serve internal files/directories or browser-facing branding assets.
    RewriteRule ^(?:\.env|\.git|app|bootstrap|config|database|resources|routes|storage|tests|vendor|composer\.(?:json|lock)|package\.(?:json|lock)|artisan|phpunit\.xml)(?:/|$) - [F,L]
    RewriteRule ^(?:safa-logo\.png|favicon\.svg)$ - [F,L]

    # Every request goes through Laravel so non-API requests receive JSON 404.
    RewriteRule ^ index.php [L]
</IfModule>

<FilesMatch "^\.|\.env|composer\.(json|lock)|package\.(json|lock)|artisan|phpunit\.xml|README\.md">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Turn off Directory Indexing
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block access to all hidden dotfiles (e.g. .env, .git, .gitignore, .htaccess)
    RewriteRule (^\/|\/|\.)\.(?!well-known) - [F,L]

    # 2. The authenticated browser application uses /app and /app/api/* as
    # Laravel routes. Route those exact URL surfaces before denying direct
    # filesystem access to the real app/ source directory below.
    RewriteRule ^app/?$ index.php [L]
    RewriteRule ^app/api(?:/.*)?$ index.php [L]

    # 3. Block direct web access to sensitive system files & internal directories.
    # Requests such as /app/Http/... remain forbidden.
    RewriteRule ^(app|bootstrap|config|database|public|resources|routes|storage|tests|vendor|composer\.(json|lock)|package\.(json|lock)|artisan|phpunit\.xml|README\.md|metadata\.json|\.env|\.git) - [F,L]

    # 4. Route all legitimate web traffic to index.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Fallback Access Denial for Apache 2.2 / 2.4 / LiteSpeed
<FilesMatch "^\.|\.env|composer\.(json|lock)|package\.(json|lock)|artisan|phpunit\.xml|README\.md">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

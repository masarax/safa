APP_NAME=SAFA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://safa.masarax.com

# Public mobile client identifier. Do not put private secrets in the APK.
SAFA_API_KEY=

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# API-first backend: no database session/cache dependency is required.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

